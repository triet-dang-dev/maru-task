# Optional absolute or root-relative browser API base. Defaults to same-origin /api.
NEXT_PUBLIC_API_BASE_URL=/api

# Optional: development, test, staging, or production. Defaults to development.
NEXT_PUBLIC_APP_ENV=development

# Server-only. These values match the current .NET auth contract.
AUTH_COOKIE_NAME=jwt_token
# Raw .NET origin; controllers are rooted at /auth, not /api/v1/auth.
DOTNET_API_BASE_URL=http://localhost:5000
DOTNET_API_TIMEOUT_MS=15000

# BFF mocks are enabled by default in `next dev` and disabled in production.
USE_MOCK_API=true

# Development-only UI session bypass. Never enable this in production.
MOCK_AUTH=false
OIDC_ENTRA_ENABLE_JIT_PROVISIONING=false